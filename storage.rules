rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && "admin" in request.auth.token
        && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*')
        || request.resource.contentType == 'application/octet-stream';
    }

    function ownsExistingFile() {
      return signedIn()
        && resource != null
        && "ownerUID" in resource.metadata
        && resource.metadata.ownerUID == request.auth.uid;
    }

    function createsOwnedFile() {
      return signedIn()
        && request.resource != null
        && "ownerUID" in request.resource.metadata
        && request.resource.metadata.ownerUID == request.auth.uid;
    }

    match /avatars/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && (
        (request.resource == null
          && (fileName == request.auth.uid + '.jpg' || isAdmin()))
        || (request.resource != null
          && fileName == request.auth.uid + '.jpg'
          && request.resource.size < 5 * 1024 * 1024
          && isImage())
      );
    }

    match /chat_images/{fileName} {
      allow read: if signedIn();
      allow write: if
        (request.resource == null && (ownsExistingFile() || isAdmin()))
        || (request.resource != null
          && createsOwnedFile()
          && (resource == null || ownsExistingFile())
          && request.resource.size < 25 * 1024 * 1024
          && (isImage() || request.resource.contentType == 'application/octet-stream'));
    }

    match /voice_notes/{fileName} {
      allow read: if signedIn();
      allow write: if
        (request.resource == null && (ownsExistingFile() || isAdmin()))
        || (request.resource != null
          && createsOwnedFile()
          && (resource == null || ownsExistingFile())
          && request.resource.size < 25 * 1024 * 1024
          && isAudio());
    }

    match /shared_files/{fileName} {
      allow read: if signedIn();
      allow write: if
        (request.resource == null && (ownsExistingFile() || isAdmin()))
        || (request.resource != null
          && createsOwnedFile()
          && (resource == null || ownsExistingFile())
          && request.resource.size < 50 * 1024 * 1024);
    }

    match /communities/{fileName} {
      allow read: if signedIn();
      allow write: if
        (request.resource == null && (ownsExistingFile() || isAdmin()))
        || (request.resource != null
          && signedIn()
          && (
            resource == null
            || (ownsExistingFile() && createsOwnedFile())
          )
          && fileName.matches('.*\\.jpg')
          && request.resource.size < 5 * 1024 * 1024
          && isImage());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
